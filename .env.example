# Firebase Configuration Template
# Copy this file to .env and fill in your values from Firebase Console
# Download google-services.json and GoogleService-Info.plist from Firebase Console

# Project Info
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PROJECT_NUMBER=your-project-number
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app

# Android Configuration
ANDROID_APP_ID=1:your-project-number:android:your-app-hash
ANDROID_API_KEY=your-android-api-key
ANDROID_OAUTH_CLIENT_ID=your-android-oauth-client-id.apps.googleusercontent.com
ANDROID_CERTIFICATE_HASH=your-sha1-certificate-hash

# iOS Configuration
IOS_APP_ID=1:your-project-number:ios:your-app-hash
IOS_API_KEY=your-ios-api-key
IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
IOS_REVERSED_CLIENT_ID=com.googleusercontent.apps.your-ios-client-id

# Web OAuth Client (used for Google Sign-In)
WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# GCM/FCM
GCM_SENDER_ID=your-project-number
